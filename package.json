{
  "name": "@identity/auth",
  "version": "0.1.0",
  "private": true,
  "repository": "https://github.com/just-every/run-auth",
  "homepage": "https://run-auth.com",
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "node scripts/rer.mjs build",
    "dev": "node scripts/rer.mjs dev",
    "preview": "node scripts/rer.mjs preview",
    "typecheck": "tsc --build --incremental",
    "test:typecheck": "node scripts/base-onboarding/queued-entry.mjs test:typecheck -- sh -c \"node --test tests/incremental-typecheck.test.mjs\"",
    "verify": "node scripts/rer.mjs verify",
    "setup": "node scripts/rer.mjs setup",
    "deploy": "node scripts/rer.mjs deploy",
    "test:runtime": "node scripts/base-onboarding/queued-entry.mjs test:runtime -- sh -c \"node tests/runtime.mjs\"",
    "test:email-link": "node scripts/base-onboarding/queued-entry.mjs test:email-link -- sh -c \"node tests/email-link.mjs\"",
    "onboard": "node scripts/install.mjs",
    "build:app": "node scripts/base-onboarding/queued-entry.mjs build:app -- sh -c \"vite build\"",
    "verify:app": "node scripts/base-onboarding/queued-entry.mjs verify:app -- sh -c \"pnpm run build && pnpm run typecheck && pnpm run test:typecheck && pnpm run test:runtime && pnpm run test:email-link && pnpm run test:auth && pnpm run test:site && pnpm run test:browser\"",
    "reset": "node scripts/rer.mjs reset",
    "export": "node scripts/rer.mjs export",
    "import": "node scripts/rer.mjs import",
    "release": "node scripts/rer.mjs release",
    "outbox": "node scripts/rer.mjs outbox",
    "doctor": "node scripts/rer.mjs doctor",
    "describe": "node scripts/rer.mjs describe",
    "check": "node scripts/rer.mjs check",
    "deps": "node scripts/rer.mjs install",
    "rer": "node scripts/rer.mjs",
    "test:auth": "node --test --test-concurrency=1 tests/auth/linking.test.mjs tests/auth/rer-approval.test.mjs tests/auth/security.test.mjs tests/auth/registration.test.mjs tests/auth/fresh-proof.test.mjs tests/auth/local-email.test.mjs tests/auth/protocol.test.mjs tests/auth/authorization-policy.test.mjs tests/auth/userinfo.test.mjs tests/auth/upstreams.test.mjs tests/auth/move-in-staging.test.mjs tests/auth/move-in-admission.test.mjs tests/auth/agents-keys.test.mjs tests/auth/agents-proposals.test.mjs tests/auth/recovery-cli.test.mjs tests/auth/saml.test.mjs tests/auth/provisioning.test.mjs tests/auth/catalog.test.mjs tests/integration/http.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/auth/browser.test.mjs tests/integration/browser.test.mjs tests/integration/move-in-browser.test.mjs tests/integration/agents-browser.test.mjs tests/integration/company-apps-browser.test.mjs tests/integration/dev.test.mjs",
    "test:site": "node --test tests/site/run-site.test.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@node-saml/node-saml": "5.1.0",
    "@playwright/test": "1.55.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "marked": "18.0.14",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  }
}
