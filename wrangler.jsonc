{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "identity-auth",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "auth",
      "database_id": "local-auth-only",
      "migrations_dir": "migrations/core"
    }
  ]
}
